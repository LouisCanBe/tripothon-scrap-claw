{
  "name": "tripothon-scrap-claw",
  "private": true,
  "type": "module",
  "description": "TripoThon 拾荒娃娃机 — dev tooling only (game runs without npm install)",
  "//devDependencies": "gltfpack / sharp 是**离线资产优化工具**（tools/gltf-optimize.mjs），游戏运行时零引用。故意不放 devDependencies：Render 的 build 若跑 npm install，sharp 会触发平台二进制下载，平添一个失败面。需要时手动 npm i -D gltfpack sharp。",
  "devDependencies": {
    "pixverse": "^1.4.6"
  },
  "scripts": {
    "start": "node tools/devServer.mjs 8000",
    "game": "node tools/devServer.mjs 8000",
    "game:dev": "node tools/devServer.mjs 8000 --gui",
    "game:lan": "node tools/devServer.mjs 8000 --lan",
    "dev": "node tools/devServer.mjs 8000 --gui",
    "hub": "node tools/hub.serve.mjs",
    "pixverse": "pixverse",
    "pixverse:login": "pixverse auth login",
    "pixverse:status": "pixverse auth status",
    "skills:pixverse": "npx skills add https://github.com/pixverseai/skills --skill pixverse-ai-image-and-video-generator --project -y",
    "build:deploy": "node tools/build-deploy.mjs",
    "optimize:assets": "node tools/gltf-optimize.mjs"
  }
}
